# --- Sanity (from sanity.io/manage → your project) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="lc5grag2"
NEXT_PUBLIC_SANITY_DATASET="production"
# A "Viewer" token (API → Tokens). Lets the live preview in the dashboard show unpublished drafts.
SANITY_API_READ_TOKEN=""

# --- Contact form (resend.com) ---
RESEND_API_KEY=""
# Where messages are delivered
CONTACT_TO_EMAIL="me@srod.ca"
# Must be on a domain you've verified in Resend (e.g. srod.ca). For testing use onboarding@resend.dev
CONTACT_FROM_EMAIL="srod.ca <website@srod.ca>"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL="https://srod.ca"
